# MOA 백엔드 환경변수. 이 파일을 .env로 복사해서 값을 채우세요: cp .env.example .env
# .env는 git에 올라가지 않습니다(.gitignore). 값에 따옴표는 붙이지 마세요.
# Render 배포 시에는 이 파일 대신 render.yaml + 대시보드에서 값을 넣습니다.

# ---------- DB ----------
# 로컬: docker-compose의 Postgres (docker compose up -d). 비워 두면 아래 기본값과 같다.
DB_URL=jdbc:postgresql://localhost:5432/moa
DB_USERNAME=moa
DB_PASSWORD=moa
# Render(SPRING_PROFILES_ACTIVE=render)에서는 Postgres에 붙고, 아래 값은 render.yaml이 DB에서 자동으로 채운다.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=moa

# ---------- CSV ----------
# CSV를 읽고 쓸 최상위 폴더 (이 밖의 경로는 거부)
CSV_BASE_DIR=./data/csv

# ---------- Google 폼 (OAuth) ----------
# GCP 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 클라이언트의 "승인된 리디렉션 URI"에 똑같이 등록해야 함
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback
# 계정 연결 후 refresh token이 저장되는 파일
GOOGLE_CREDENTIAL_FILE=./data/google/credential.json
# /oauth/google/** 를 localhost 밖에서도 허용할지. 프록시(Render) 뒤에서만 필요하고, 켜면 누구나 접근 가능하니 기본은 false
GOOGLE_OAUTH_ALLOW_REMOTE=false

# ---------- AI ----------
# 요청에 provider를 안 주면 쓸 기본 제공자: upstage / gemini
AI_PROVIDER=upstage

# Upstage Solar
# console.upstage.ai → API Keys 에서 발급
UPSTAGE_API_KEY=
# solar-pro4(고성능) / solar-mini4(빠르고 저렴)
UPSTAGE_MODEL=solar-pro4

# Google Gemini: aistudio.google.com → Get API key 에서 발급
GEMINI_API_KEY=
# gemini-3.6-flash(범용) / gemini-3.5-flash-lite(빠르고 저렴)
GEMINI_MODEL=gemini-3.6-flash

# ---------- 테스트 API ----------
# /test/** 엔드포인트 사용 여부. 운영에서는 false
TEST_API_ENABLED=true
